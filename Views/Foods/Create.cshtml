@model banhmihanhphuc.Models.Food

@{
    ViewData["Title"] = "Thêm món";

    var categories =
        ViewBag.Categories as List<banhmihanhphuc.Models.Category>;
}

<style>
    .food-form-page {
        max-width: 720px;
        margin: 35px auto;
    }

    .food-form-card {
        background: white;
        padding: 32px;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.07);
    }

    .food-form-card h2 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .form-description {
        color: #777;
        margin-bottom: 28px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #ddd;
        border-radius: 9px;
        font-size: 15px;
    }

    .form-control:focus {
        outline: none;
        border-color: #f97316;
        box-shadow: 0 0 0 3px rgba(249,115,22,0.1);
    }

    .image-preview {
        display: none;
        width: 180px;
        height: 130px;
        margin-top: 12px;
        border: 1px dashed #ccc;
        border-radius: 10px;
        overflow: hidden;
        background: #fafafa;
    }

    .image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }

    .btn-back,
    .btn-save {
        flex: 1;
        padding: 12px;
        border-radius: 9px;
        text-align: center;
        text-decoration: none;
        font-weight: 600;
    }

    .btn-back {
        background: white;
        color: #333;
        border: 1px solid #ddd;
    }

    .btn-save {
        border: none;
        background: #f97316;
        color: white;
        cursor: pointer;
    }

    .btn-save:hover {
        background: #ea580c;
    }
</style>


<div class="food-form-page">

    <div class="food-form-card">

        <h2>Thêm món mới</h2>

        <div class="form-description">
            Nhập thông tin món ăn mới của Bánh Mì Hạnh Phúc
        </div>


        <form asp-controller="Foods"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- Tên món -->
            <div class="form-group">

                <label asp-for="Name">
                    Tên món
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Ví dụ: Bánh mì bò nướng" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>


            <!-- Danh mục -->
            <div class="form-group">

                <label asp-for="CategoryId">
                    Danh mục
                </label>

                <select asp-for="CategoryId"
                        class="form-control">

                    <option value="">
                        -- Chọn danh mục --
                    </option>

                    @if (categories != null)
                    {
                        foreach (var category in categories)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }

                </select>

                <span asp-validation-for="CategoryId"
                      class="text-danger">
                </span>

            </div>


            <!-- Giá bán -->
            <div class="form-group">

                <label asp-for="Price">
                    Giá bán
                </label>

                <input asp-for="Price"
                       type="number"
                       min="0"
                       class="form-control"
                       placeholder="Ví dụ: 25000" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>

            </div>


            <!-- Ảnh món -->
            <div class="form-group">

                <label>
                    Ảnh món
                </label>

                <input type="file"
                       name="imageFile"
                       id="imageFile"
                       accept=".jpg,.jpeg,.png,.webp"
                       class="form-control" />

                <div class="image-preview"
                     id="imagePreview">

                    <img id="previewImage"
                         alt="Ảnh xem trước" />

                </div>

            </div>


            <div class="form-actions">

                <a asp-controller="Foods"
                   asp-action="Index"
                   class="btn-back">

                    ← Quay lại

                </a>

                <button type="submit"
                        class="btn-save">

                    + Thêm món

                </button>

            </div>

        </form>

    </div>

</div>


<script>
    // Hiển thị ảnh xem trước khi lưu món
    document.getElementById("imageFile")
        .addEventListener("change", function () {

            const file = this.files[0];

            if (!file) {
                return;
            }

            const reader = new FileReader();

            reader.onload = function (e) {

                document.getElementById("previewImage")
                    .src = e.target.result;

                document.getElementById("imagePreview")
                    .style.display = "block";
            };

            reader.readAsDataURL(file);
        });
</script>