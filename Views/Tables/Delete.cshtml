@model banhmihanhphuc.Models.RestaurantTable

@{
    ViewData["Title"] = "Xóa bàn";
}

<div class="delete-page">

    <div class="delete-card">

        <div class="delete-icon">
            🗑️
        </div>

        <h2>Xóa bàn?</h2>

        <p>
            Bạn có chắc chắn muốn xóa
            <strong>@Model.TableName</strong> không?
        </p>

        <div class="table-info">

            <div>
                <span>Tên bàn</span>
                <strong>@Model.TableName</strong>
            </div>

            <div>
                <span>Sức chứa</span>
                <strong>@Model.Capacity người</strong>
            </div>

        </div>


        <form asp-action="DeleteConfirmed"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <div class="delete-actions">

                <a asp-action="Index"
                   class="btn-cancel">
                    Hủy
                </a>

                <button type="submit"
                        class="btn-delete">
                    Xóa bàn
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .delete-page {
        max-width: 600px;
        margin: 50px auto;
    }

    .delete-card {
        background: white;
        padding: 35px;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        text-align: center;
    }

    .delete-icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

    .delete-card h2 {
        font-size: 27px;
        margin-bottom: 10px;
    }

    .delete-card p {
        color: #666;
    }

    .table-info {
        margin: 25px 0;
        padding: 20px;
        background: #fafafa;
        border-radius: 10px;
        text-align: left;
    }

    .table-info div {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
    }

    .table-info span {
        color: #777;
    }

    .delete-actions {
        display: flex;
        gap: 12px;
    }

    .btn-cancel,
    .btn-delete {
        flex: 1;
        padding: 12px;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 600;
        text-align: center;
    }

    .btn-cancel {
        background: white;
        border: 1px solid #ddd;
        color: #333;
    }

    .btn-delete {
        border: none;
        background: #ff3b30;
        color: white;
        cursor: pointer;
    }

</style>