<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Bánh Mì Hạnh Phúc
    </title>


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- CSS chung -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <style>

        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;

            background: #f7f8fa;

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                "Helvetica Neue",
                Arial,
                sans-serif;
        }



        /* =========================================
           THANH MENU BÊN TRÁI
           ========================================= */

        .sidebar {
            position: fixed;

            top: 0;
            left: 0;

            width: 220px;
            height: 100vh;

            background: linear-gradient(
                180deg,
                #321d0d 0%,
                #1f160f 100%
            );

            color: white;

            display: flex;
            flex-direction: column;

            z-index: 1000;
        }



        /* =========================================
           LOGO + TÊN QUÁN
           ========================================= */

        .sidebar-brand {
            padding: 24px 18px;

            border-bottom:
                1px solid rgba(255,255,255,0.08);
        }


        .brand-title {
            font-size: 24px;

            font-weight: 700;

            color: #ff7a00;

            line-height: 1.15;
        }


        .brand-subtitle {
            margin-top: 7px;

            font-size: 12px;

            color: #dddddd;
        }



        /* =========================================
           DANH SÁCH MENU
           ========================================= */

        .sidebar-menu {
            padding: 18px 10px;

            flex: 1;
        }


        .sidebar-link {
            display: flex;

            align-items: center;

            gap: 13px;

            color: #f5f5f5;

            text-decoration: none;

            padding: 13px 15px;

            margin-bottom: 7px;

            border-radius: 9px;

            font-size: 15px;

            font-weight: 500;

            transition: 0.2s;
        }


        .sidebar-link:hover {
            background:
                rgba(255,255,255,0.08);

            color: white;
        }


        .sidebar-link.active {
            background: #ff6500;

            color: white;
        }


        .sidebar-icon {
            width: 23px;

            text-align: center;

            font-size: 19px;
        }



        /* =========================================
           ĐĂNG XUẤT
           ========================================= */

        .sidebar-bottom {
            padding: 15px;

            border-top:
                1px solid rgba(255,255,255,0.08);
        }


        .btn-logout {
            width: 100%;

            border:
                1px solid rgba(255,255,255,0.3);

            background: transparent;

            color: white;

            padding: 11px;

            border-radius: 8px;

            cursor: pointer;

            font-weight: 600;
        }


        .btn-logout:hover {
            background: #dc2626;

            border-color: #dc2626;
        }



        /* =========================================
           NỘI DUNG BÊN PHẢI
           ========================================= */

        .page-wrapper {
            margin-left: 220px;

            min-height: 100vh;
        }


        .main-content {
            padding: 25px;
        }



        /* =========================================
           RESPONSIVE
           ========================================= */

        @@media (max-width: 900px) {

            .sidebar {
                width: 75px;
            }


            .brand-title {
                font-size: 0;
            }


            .brand-title::after {
                content: "🥖";

                font-size: 30px;
            }


            .brand-subtitle {
                display: none;
            }


            .sidebar-link span:last-child {
                display: none;
            }


            .sidebar-link {
                justify-content: center;
            }


            .page-wrapper {
                margin-left: 75px;
            }
        }

    </style>

</head>


<body>

    @{
        // Lấy Controller đang mở
        var currentController =
            ViewContext.RouteData.Values["controller"]
                ?.ToString();

        // Kiểm tra quyền người dùng
        var isAdmin =
            User.IsInRole("Admin");

        var isStaff =
            User.IsInRole("Staff");
    }



    <!-- =========================================
         THANH MENU BÊN TRÁI
         ========================================= -->

    <aside class="sidebar">


        <!-- =========================================
             TÊN QUÁN
             ========================================= -->

        <div class="sidebar-brand">

            <div class="brand-title">

                BÁNH MÌ<br />

                HẠNH PHÚC

            </div>


            <div class="brand-subtitle">

                Ngon lành - Hạnh phúc mỗi ngày!

            </div>

        </div>



        <!-- =========================================
             CÁC CHỨC NĂNG
             ========================================= -->

        <div class="sidebar-menu">


            <!-- =========================================
                 TỔNG QUAN
                 ADMIN + STAFF ĐỀU ĐƯỢC XEM
                 ========================================= -->

            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-link @(currentController == "Home" ? "active" : "")">

                <span class="sidebar-icon">
                    ⌂
                </span>

                <span>
                    Tổng quan
                </span>

            </a>



            <!-- =========================================
                 BÁN HÀNG
                 ADMIN + STAFF ĐỀU ĐƯỢC XEM
                 ========================================= -->

            <a asp-controller="Sales"
               asp-action="Index"
               class="sidebar-link @(currentController == "Sales" ? "active" : "")">

                <span class="sidebar-icon">
                    🛒
                </span>

                <span>
                    Bán hàng
                </span>

            </a>



            <!-- =========================================
                 CHỈ ADMIN ĐƯỢC QUẢN LÝ BÀN
                 ========================================= -->

            @if (isAdmin)
            {
                <a asp-controller="Tables"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Tables" ? "active" : "")">

                    <span class="sidebar-icon">
                        🪑
                    </span>

                    <span>
                        Bàn
                    </span>

                </a>
            }



            <!-- =========================================
                 CHỈ ADMIN ĐƯỢC QUẢN LÝ MÓN
                 ========================================= -->

            @if (isAdmin)
            {
                <a asp-controller="Foods"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Foods" ? "active" : "")">

                    <span class="sidebar-icon">
                        🥖
                    </span>

                    <span>
                        Món ăn
                    </span>

                </a>
            }



            <!-- =========================================
                 HÓA ĐƠN
                 ADMIN + STAFF ĐỀU ĐƯỢC XEM
                 ========================================= -->

            <a asp-controller="Invoices"
               asp-action="Index"
               class="sidebar-link @(currentController == "Invoices" ? "active" : "")">

                <span class="sidebar-icon">
                    🧾
                </span>

                <span>
                    Hóa đơn
                </span>

            </a>



            <!-- =========================================
                 CHỈ ADMIN ĐƯỢC XEM THỐNG KÊ
                 ========================================= -->

            @if (isAdmin)
            {
                <a asp-controller="Statistics"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Statistics" ? "active" : "")">

                    <span class="sidebar-icon">
                        📊
                    </span>

                    <span>
                        Thống kê
                    </span>

                </a>
            }


        </div>



        <!-- =========================================
             ĐĂNG XUẤT
             ========================================= -->

        <div class="sidebar-bottom">


            @if (User.Identity != null &&
                 User.Identity.IsAuthenticated)
            {
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="btn-logout">

                        Đăng xuất

                    </button>

                </form>
            }


        </div>

    </aside>



    <!-- =========================================
         NỘI DUNG HỆ THỐNG
         ========================================= -->

    <div class="page-wrapper">


        <main class="main-content">

            @RenderBody()

        </main>


    </div>



    <!-- =========================================
         JAVASCRIPT
         ========================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


</body>

</html>